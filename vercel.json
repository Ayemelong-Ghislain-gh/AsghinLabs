{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "asghinlabs.vercel.app"
        }
      ],
      "destination": "https://www.asghinlabs.com/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(images|vendor|files)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}